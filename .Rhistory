library(dplyr)
library(ggplot2)
library(MASS)
library(tidyr)
library(stringr)
library(car)
library(lubridate)
library(forecast)
library(olsrr)
library(leaps)
library(readxl)
data = read_xlsx("data/Creating CFD plots.xlsx")
head(data)
data %>% ggplot(aes(x=Year,y=`Cash Flow (discounted)`)) +
geom_segment(aes(xend = Year, y=0,
yend =`Cash Flow (discounted)`),
linetype = "dotted") +
geom_line(aes(group = 1)) +
geom_point(size=3,color = 'green') + theme_minimal()
data %>% ggplot(aes(x=Year,y=`Cash Flow (discounted)`)) +
geom_segment(aes(xend = Year, y=0,
yend =`Cash Flow (discounted)`),
linetype = "dotted") +
geom_line(aes(group = 1)) + theme_minimal()
data %>% ggplot(aes(x=Year,y=`Cash Flow (non-discounted)`)) +
geom_segment(aes(xend = Year, y=0,
yend =`Cash Flow (non-discounted)`),
linetype = "dotted") +
geom_line(aes(group = 1)) + theme_minimal()
data %>% ggplot(aes(x=Year,y=`Cash Flow (Non-discounted)`)) +
